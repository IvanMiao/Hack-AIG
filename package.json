{
  "name": "nemesis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-offline-build.mjs",
    "build:itch": "npm run build && node scripts/build-itch.mjs",
    "bake:fallback": "vite-node scripts/bake-fallback.ts",
    "art:gen": "node scripts/gen-art.mjs",
    "art:process": "${BLENDER:-blender} -b --factory-startup --python blender/process_art.py",
    "assets:build": "${BLENDER:-blender} -b --factory-startup --python blender/build_assets.py -- --out src/assets/models",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "lil-gui": "^0.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.1",
    "adm-zip": "^0.5.16",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "wrangler": "4.135.0"
  }
}
